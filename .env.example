# Server Port
PORT=3000

# Browser Mode:
# 'new'   -> Recommended stealth mode (Google Chrome --headless=new)
# 'false' -> Headed mode (opens a visible browser window)
# 'true'  -> Classic standard headless mode
HEADLESS=new

# SQLite Database Location
DB_PATH=./data/tracker.sqlite

# Automated Scheduled Scraping (Cron)
CRON_ENABLED=true
CRON_SCHEDULE="0 3 * * *"
CRON_PAGES=120
